# Use a unique topic name (not the public Reddit channel unless that is yours).
NTFY_TOPIC_ALL=odyssey_nyc_my_alerts

# Optional: custom ntfy server (default https://ntfy.sh)
NTFY_BASE_URL=https://ntfy.sh

# Optional: ntfy auth token if your topic is access-controlled
# NTFY_TOKEN=

# How often to poll AMC (seconds)
POLL_INTERVAL_SECONDS=45

# Days ahead to scan for IMAX 70mm Odyssey showtimes
LOOKAHEAD_DAYS=25

# AMC Lincoln Square 13 — Odyssey (The Odyssey)
THEATRE_LOCATION=new-york-city
THEATRE_KEY=amc-lincoln-square-13
MOVIE_TITLE=The Odyssey
PREMIUM_OFFERING=70mm
